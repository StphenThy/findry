# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS). Add your Vercel URL in prod.
CLIENT_URL=http://localhost:5173

# Set to "true" to have Express serve the built React app from ../client/dist
# (single-server deploy). Leave "false" when the client is on Vercel/Netlify.
SERVE_CLIENT=false

# ── Database ────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. If left EMPTY the server boots an
# in-memory MongoDB (mongodb-memory-server) and auto-seeds demo data —
# perfect for local demos, but data is lost on restart.
MONGODB_URI=

# Auto-run the demo seed on startup when the database is empty.
SEED_ON_START=true

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── AI ──────────────────────────────────────────────────────────────────
# auto   → gemini if GEMINI_API_KEY is set, otherwise local
# gemini → Google Gemini (free tier) for resume parsing, skill suggestion, gap advice
# local  → deterministic skill-dictionary parser, no external calls, no keys
# mock   → returns the Maria Santos demo fixture regardless of input
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Uploads ─────────────────────────────────────────────────────────────
# Where resume files are stored in dev. On Render the disk is ephemeral,
# so parsed text is always persisted to MongoDB regardless of this setting.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ── Mail (password reset) ───────────────────────────────────────────────
# Leave SMTP_HOST empty in development: reset links are printed to the server
# console (and shown on screen) instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Findry <no-reply@findry.local>

# ── AI budget ───────────────────────────────────────────────────────────
# Caps on REAL Gemini calls. Identical requests are served from a cache first;
# once a cap is hit the built-in local engine answers instead (never an error).
# Gemini free tier is roughly 10–15 requests/minute and a few hundred per day —
# keep these under your tier's limits. Cache entries live AI_CACHE_DAYS days.
AI_DAILY_CALL_LIMIT=200
AI_PER_MINUTE_LIMIT=8
AI_COOLDOWN_MINUTES=15
AI_CACHE_DAYS=14
